{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  dependencyDashboard: false,

  enabledManagers: ["dockerfile", "pip-compile"],

  "pip-compile": {
    managerFilePatterns: ["/^api/2[3-5]-alpine/requirements\\.txt$/"],
  },

  forkProcessing: "enabled",

  includePaths: [
    "director-pgsql/2[3-5]-*/**",
    "storage/2[3-5]-*/**",
    "client/2[3-5]-*/**",
    "webui/2[3-5]-*/**",
    "api/2[3-5]-alpine/**",
    ".github/actions/*/**",
    "bareos-packages/**",
    "bareos-alpine-packages/**",
  ],

  packageRules: [
    {
      matchPackageNames: ["*"],
      enabled: false,
    },
    {
      matchPackageNames: [
        "alpine",
        "ubuntu",
        "python",
        "docker",
        "ghcr.io/regclient/regctl",
      ],
      enabled: true,
    },
    {
      matchManagers: ["pip-compile"],
      enabled: true,
      groupName: "bareos-python-dependencies",
      schedule: ["before 6am on monday"],
    },
    {
      matchManagers: ["pip-compile"],
      matchPackageNames: ["bareos-restapi", "python-bareos"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchPackageNames: [
        "alpine",
        "ubuntu",
        "python",
        "docker",
        "ghcr.io/regclient/regctl",
      ],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      matchPackageNames: ["alpine"],
      groupName: "alpine",
    },
    {
      matchPackageNames: ["ubuntu"],
      groupName: "ubuntu",
    },
    {
      matchPackageNames: ["python"],
      groupName: "python",
    },
    {
      matchPackageNames: ["docker"],
      groupName: "docker-cli",
    },
  ],
}
