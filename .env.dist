# All *_PASSWORD variables below ship empty. Container startup is refused if a
# required password is left empty (or still equals a retired example value
# from an old copy of this file). Each *_PASSWORD also has a *_FILE variant
# (e.g. DB_PASSWORD_FILE) for Docker/Kubernetes secrets: point it at a file
# containing the password instead of setting the variable directly. Setting
# both for the same password is rejected. See the README's "Secrets" section.

# Bareos DB user & password
DB_USER=bareos
DB_PASSWORD=

# DB Admin user & password (required to init new pgsql instance)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Bareos Storage Daemon
BAREOS_SD_PASSWORD=

# Bareos File Daemon (client)
BAREOS_FD_PASSWORD=

# Bareos WEBUI
BAREOS_WEBUI_PASSWORD=

# Bareos DB migration only (MySQL to PostgreSQL)
MYSQL_DB_PASSWORD=
PGSQL_DB_PASSWORD=
MYSQL_ADMIN_PASSWORD=
PGSQL_ADMIN_PASSWORD=
